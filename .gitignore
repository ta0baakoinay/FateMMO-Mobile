AndroidClient/webview-app/app/src/main/assets/web/*
!AndroidClient/webview-app/app/src/main/assets/web/bg_loading.jpg

# ---- big binaries / artifacts (re-obtainable, or not redistributable) ----
AndroidClient/artifacts/
*.apk
*.aab
*.keystore
*.jks
*.zip

# supplied source material - huge and/or not for public redistribution
/Client/
/Server/
RagnaFinest_v623.apk

# vendored upstream repos flattened into this tree (their history lives upstream)
**/_git_vendored_disabled/

