roBrowserLegacy compatibility patch for the Fate MMO rAthena source
==================================================================

roBrowser cannot speak rAthena's packet obfuscation, and it needs the
server PACKETVER to be one it has packet tables for (<= ~2022; 20180620
is the tested target). Apply BOTH hunks, then rebuild the server.

Reverting = `git apply -R robrowser-compat.patch` (or flip the two lines back).

--- a/src/config/packets.hpp
+++ b/src/config/packets.hpp
@@ -44,7 +44,7 @@
 #if PACKETVER >= 20110817
 	/// Comment to disable the official packet obfuscation support.
 	/// This requires PACKETVER 2011-08-17 or newer.
 	#ifndef PACKET_OBFUSCATION
-		#define PACKET_OBFUSCATION
+		//#define PACKET_OBFUSCATION

 		// Define these inside src/custom/defines_pre.hpp or src/custom/defines_post.hpp
 		//#define PACKET_OBFUSCATION_KEY1 <key1>
--- a/src/custom/defines_pre.hpp
+++ b/src/custom/defines_pre.hpp
@@ -13,6 +13,6 @@
  * For detailed guidance on these check http://rathena.org/wiki/SRC/config/
  **/

-#define PACKETVER 20250716
+#define PACKETVER 20180620

 #endif /* CONFIG_CUSTOM_DEFINES_PRE_HPP */
